.tab-shell {
  position: fixed;
  z-index: 999;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 0 22rpx env(safe-area-inset-bottom);
  pointer-events: none;
}

.tab-inner {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  overflow: hidden;
  border: 1rpx solid rgba(216, 225, 231, 0.18);
  border-bottom: 0;
  border-radius: 40rpx 40rpx 0 0;
  background: rgba(5, 11, 20, 0.94);
  box-shadow: 0 -16rpx 50rpx rgba(0, 0, 0, 0.32);
  backdrop-filter: blur(28rpx);
  pointer-events: auto;
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 108rpx;
  color: #748699;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  transition: color 180ms ease;
}

.tab-item.is-active {
  color: #f3f0e8;
}

.tab-item.is-active::after {
  position: absolute;
  right: 28rpx;
  bottom: 0;
  left: 28rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #d8e1e7, transparent);
  content: '';
}

.tab-mark {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  color: currentColor;
}

.tab-mark--star {
  border: 1rpx solid currentColor;
  border-radius: 50%;
}

.tab-mark--star .mark-core {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 16rpx;
  height: 16rpx;
  background: currentColor;
  clip-path: polygon(50% 0, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0 50%, 39% 39%);
}

.tab-mark--line::before,
.tab-mark--line::after,
.tab-mark--line .mark-core {
  position: absolute;
  right: 0;
  left: 0;
  height: 1rpx;
  background: currentColor;
  content: '';
}

.tab-mark--line::before { top: 6rpx; }
.tab-mark--line .mark-core { top: 16rpx; }
.tab-mark--line::after { top: 26rpx; }

.tab-mark--circle {
  border: 1rpx solid currentColor;
  border-radius: 50%;
}

.tab-mark--circle::after {
  position: absolute;
  top: 15rpx;
  left: 15rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
  content: '';
}

.tab-mark--person::before {
  position: absolute;
  top: 0;
  left: 11rpx;
  width: 12rpx;
  height: 12rpx;
  border: 1rpx solid currentColor;
  border-radius: 50%;
  content: '';
}

.tab-mark--person::after {
  position: absolute;
  right: 3rpx;
  bottom: 0;
  left: 3rpx;
  height: 16rpx;
  border: 1rpx solid currentColor;
  border-radius: 20rpx 20rpx 0 0;
  content: '';
}
