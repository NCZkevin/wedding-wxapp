.interact-hero { position: relative; height: 920rpx; overflow: hidden; }
.interact-hero > image,
.interact-shade { position: absolute; width: 100%; height: 100%; }
.interact-hero > image { filter: saturate(0.58) brightness(0.66); }
.interact-shade { background: linear-gradient(180deg, rgba(5, 9, 16, 0.18), #07111f 100%); }
.gallery-frame { position: absolute; border: 1rpx solid rgba(216, 225, 231, 0.26); }
.gallery-frame--a { top: 140rpx; right: 70rpx; width: 210rpx; height: 260rpx; transform: rotate(7deg); }
.gallery-frame--b { top: 200rpx; left: 54rpx; width: 170rpx; height: 220rpx; transform: rotate(-8deg); }
.interact-copy { position: absolute; right: 40rpx; bottom: 52rpx; left: 40rpx; }
.interact-title { margin-top: 22rpx; font-size: 54rpx; line-height: 1.5; letter-spacing: 6rpx; }
.interact-title text { display: block; }
.interact-subtitle { display: block; max-width: 610rpx; margin-top: 24rpx; color: #99aab7; font-size: 23rpx; line-height: 1.7; }
.chapter-row { display: flex; align-items: center; justify-content: space-between; }

.photo-section { padding: 110rpx 40rpx 120rpx; }
.photo-gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24rpx 18rpx; margin-top: 58rpx; }
.photo-item { position: relative; height: 390rpx; padding: 12rpx 12rpx 44rpx; background: #faf8f3; box-shadow: 0 20rpx 46rpx rgba(16, 27, 38, 0.16); }
.photo-item--0 { transform: rotate(-1.4deg); }
.photo-item--1 { transform: translateY(24rpx) rotate(1.6deg); }
.photo-item--2 { transform: rotate(0.8deg); }
.photo-item image { width: 100%; height: 100%; background: #d8e1e7; }
.photo-index { position: absolute; bottom: 13rpx; left: 16rpx; color: #536371; font-family: serif; font-size: 16rpx; letter-spacing: 3rpx; }
.photo-remove { position: absolute; top: 20rpx; right: 20rpx; display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: rgba(5, 9, 16, 0.68); font-size: 23rpx; }
.photo-add-small { display: flex; height: 390rpx; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; border: 1rpx solid rgba(11, 24, 38, 0.22); color: #2d4150; font-size: 22rpx; letter-spacing: 3rpx; }
.photo-add-small text:first-child { font-size: 50rpx; font-weight: 200; }

.upload-stage { position: relative; display: flex; width: 100%; min-height: 520rpx; flex-direction: column; align-items: center; justify-content: center; margin-top: 54rpx; overflow: hidden; border: 1rpx solid rgba(11, 24, 38, 0.2); color: #0b1826; background: radial-gradient(circle at center, rgba(106, 173, 202, 0.16), transparent 54%); }
.upload-orbit { position: absolute; border: 1rpx solid rgba(11, 24, 38, 0.13); border-radius: 50%; }
.upload-orbit--a { width: 360rpx; height: 360rpx; }
.upload-orbit--b { width: 520rpx; height: 260rpx; transform: rotate(-18deg); }
.upload-cross { position: relative; z-index: 2; display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(11, 24, 38, 0.38); border-radius: 50%; font-size: 48rpx; font-weight: 200; }
.upload-title { position: relative; z-index: 2; margin-top: 34rpx; font-size: 34rpx; letter-spacing: 4rpx; }
.upload-copy { position: relative; z-index: 2; margin-top: 14rpx; color: #667683; font-size: 20rpx; }

.blessing-section { padding-top: 110rpx; padding-bottom: 120rpx; }
.record-stage { position: relative; display: flex; min-height: 620rpx; flex-direction: column; align-items: center; justify-content: flex-end; margin-top: 54rpx; overflow: hidden; padding: 50rpx 30rpx; border-top: 1rpx solid rgba(216, 225, 231, 0.22); border-bottom: 1rpx solid rgba(216, 225, 231, 0.12); background: radial-gradient(circle at 50% 36%, rgba(69, 123, 157, 0.2), transparent 46%); }
.voice-bloom { position: absolute; top: 80rpx; left: 50%; width: 260rpx; height: 280rpx; transform: translateX(-50%) scale(0.72); opacity: 0.35; transition: 800ms cubic-bezier(0.2, 0.8, 0.2, 1); }
.record-stage.is-recording .voice-bloom,
.record-stage.has-recording .voice-bloom { opacity: 1; transform: translateX(-50%) scale(1); }
.bloom-stem { position: absolute; bottom: 10rpx; left: 50%; width: 2rpx; height: 220rpx; background: linear-gradient(180deg, #edf3f6, rgba(216, 225, 231, 0.1)); transform: rotate(12deg); }
.bloom-petal { position: absolute; width: 86rpx; height: 86rpx; border: 1rpx solid rgba(237, 243, 246, 0.64); border-radius: 50% 6% 50% 6%; background: linear-gradient(135deg, rgba(237, 243, 246, 0.42), rgba(81, 116, 139, 0.05)); box-shadow: inset 0 0 24rpx rgba(255, 255, 255, 0.16); }
.bloom-petal--1 { top: 44rpx; left: 78rpx; transform: rotate(20deg); }
.bloom-petal--2 { top: 92rpx; left: 32rpx; transform: rotate(-35deg) scale(0.82); }
.bloom-petal--3 { top: 108rpx; right: 22rpx; transform: rotate(58deg) scale(0.9); }
.bloom-petal--4 { top: 16rpx; right: 32rpx; transform: rotate(96deg) scale(0.68); }
.record-stage.is-recording .bloom-petal { animation: bloomPulse 1.8s ease-in-out infinite alternate; }
@keyframes bloomPulse { from { filter: brightness(0.8); } to { filter: brightness(1.45); } }
.record-button { position: relative; z-index: 3; display: flex; width: 104rpx; height: 104rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(216, 225, 231, 0.6); border-radius: 50%; background: rgba(5, 12, 21, 0.56); }
.record-core { width: 32rpx; height: 32rpx; border-radius: 50%; background: #d8e1e7; }
.record-button.is-recording .record-core { border-radius: 6rpx; background: #b66767; transform: scale(0.76); }
.record-title { position: relative; z-index: 2; margin-top: 30rpx; font-size: 30rpx; letter-spacing: 4rpx; }
.record-time { margin-top: 12rpx; color: #71879a; font-size: 18rpx; letter-spacing: 4rpx; }
.play-button { margin-top: 16rpx; color: #d8e1e7; font-size: 20rpx; text-decoration: underline; }
.text-blessing { position: relative; margin: 30rpx 0 22rpx; padding: 30rpx 4rpx; }
.field-label { color: #8fa0b1; font-size: 18rpx; letter-spacing: 4rpx; }
.blessing-input { width: 100%; height: 200rpx; margin-top: 22rpx; color: #f3f0e8; font-family: "Songti SC", serif; font-size: 27rpx; line-height: 1.8; }
.placeholder { color: #53697b; }
.char-count { position: absolute; right: 4rpx; bottom: 18rpx; color: #53697b; font-size: 17rpx; }

.seat-section { padding: 110rpx 40rpx 120rpx; }
.seat-stage { position: relative; min-height: 690rpx; margin-top: 54rpx; overflow: hidden; color: #f3f0e8; background: #05080d; }
.seat-spotlight { position: absolute; top: -70rpx; left: 50%; width: 420rpx; height: 520rpx; background: conic-gradient(from 166deg at 50% 0%, transparent 0deg, rgba(108, 190, 222, 0.26) 14deg, transparent 28deg); filter: blur(10rpx); transform: translateX(-50%); transition: opacity 500ms ease; opacity: 0.42; }
.seat-stage.is-ready .seat-spotlight { opacity: 1; animation: seatLight 1.8s ease-in-out infinite alternate; }
@keyframes seatLight { to { filter: blur(18rpx) brightness(1.35); } }
.seat-number { position: absolute; top: 110rpx; left: 0; width: 100%; color: rgba(243, 240, 232, 0.82); font-size: 150rpx; text-align: center; text-shadow: 0 0 40rpx rgba(100, 197, 231, 0.45); }
.seat-content { position: absolute; right: 28rpx; bottom: 28rpx; left: 28rpx; padding: 28rpx; border-top: 1rpx solid rgba(216, 225, 231, 0.28); background: rgba(5, 12, 21, 0.72); backdrop-filter: blur(18rpx); }
.seat-search { display: flex; min-height: 88rpx; align-items: center; margin-top: 18rpx; border-bottom: 1rpx solid rgba(216, 225, 231, 0.28); }
.seat-search input { min-width: 0; flex: 1; padding: 0 8rpx; color: #f3f0e8; font-size: 25rpx; }
.seat-search button { display: flex; width: 120rpx; min-height: 72rpx; align-items: center; justify-content: center; color: #07111f; background: #d8e1e7; font-size: 22rpx; letter-spacing: 3rpx; }
.query-result { display: block; margin-top: 20rpx; color: #b8c5ce; font-size: 21rpx; line-height: 1.7; }
