.invite-page { padding-bottom: calc(152rpx + env(safe-area-inset-bottom)); }

.opening-scene {
  position: fixed;
  z-index: 2000;
  inset: 0;
  overflow: hidden;
  color: #f3f0e8;
  background: #02050a;
}

.opening-glow {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 28%;
  background: linear-gradient(180deg, rgba(45, 143, 185, 0.05), rgba(54, 190, 221, 0.32), rgba(5, 20, 36, 0.04));
  filter: blur(18rpx);
  transform: translateX(-50%);
  animation: glowIn 1.7s ease both;
}

.opening-curtain {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 62%;
  background:
    repeating-linear-gradient(90deg, rgba(29, 65, 96, 0.9) 0, #07111f 8%, #173a5a 16%, #040910 24%),
    #07111f;
  box-shadow: 0 0 80rpx rgba(0, 0, 0, 0.7);
  animation: curtainOpen 1.75s cubic-bezier(0.65, 0, 0.2, 1) 0.35s both;
}

.opening-curtain--left { left: 0; transform-origin: left center; }
.opening-curtain--right { right: 0; transform-origin: right center; animation-name: curtainOpenRight; }

.opening-mark {
  position: absolute;
  z-index: 3;
  top: 42%;
  left: 50%;
  display: grid;
  grid-template-columns: auto 70rpx auto;
  align-items: center;
  gap: 18rpx;
  text-align: center;
  transform: translate(-50%, -50%);
  animation: markFade 1.2s ease 0.2s both;
}

.opening-mark > view { height: 1rpx; background: rgba(243, 240, 232, 0.6); }
.opening-monogram { font-size: 64rpx; }
.opening-caption { grid-column: 1 / 4; margin-top: 20rpx; font-size: 16rpx; letter-spacing: 8rpx; }
.opening-skip { position: absolute; z-index: 4; bottom: 60rpx; width: 100%; color: #70879a; font-size: 18rpx; letter-spacing: 5rpx; text-align: center; }

@keyframes curtainOpen { to { transform: translateX(-76%) skewX(-5deg); } }
@keyframes curtainOpenRight { to { transform: translateX(76%) skewX(5deg); } }
@keyframes glowIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes markFade { 0% { opacity: 0; transform: translate(-50%, -46%); } 35% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%, -54%); } }

.hero {
  position: relative;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  padding: calc(36rpx + env(safe-area-inset-top)) 40rpx 54rpx;
  background: #07111f;
}

.hero-image,
.hero-shade,
.hero-beam { position: absolute; inset: -40rpx 0 0; width: 100%; height: calc(100% + 80rpx); }
.hero-image { filter: saturate(0.82) contrast(1.06); will-change: transform; }
.hero-shade { background: linear-gradient(180deg, rgba(4, 9, 17, 0.52), transparent 30%, rgba(4, 9, 17, 0.08) 55%, #07111f 100%); }
.hero-beam { left: 42%; width: 16%; background: linear-gradient(180deg, rgba(168, 228, 242, 0.02), rgba(168, 228, 242, 0.18) 52%, transparent 94%); filter: blur(5rpx); }

.hero-top,
.hero-content,
.hero-meta { position: relative; z-index: 2; }
.hero-top { display: flex; align-items: center; justify-content: space-between; }
.hero-kicker { font-size: 17rpx; letter-spacing: 7rpx; }
.hero-mark { font-size: 23rpx; letter-spacing: 5rpx; }

.music-button { display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(243, 240, 232, 0.7); border-radius: 50%; }
.music-icon { display: flex; height: 25rpx; align-items: center; gap: 5rpx; }
.music-icon view { width: 3rpx; height: 12rpx; background: #f3f0e8; }
.music-icon view:nth-child(2) { height: 24rpx; }

.hero-content { display: flex; flex-direction: column; align-items: center; margin-top: 15vh; }
.guest-line { margin-bottom: 38rpx; color: #dce7ec; font-family: "Songti SC", serif; font-size: 25rpx; letter-spacing: 8rpx; }
.name-lockup { display: flex; flex-direction: column; align-items: center; }
.hero-title { font-size: 72rpx; font-weight: 400; letter-spacing: 14rpx; text-shadow: 0 4rpx 28rpx rgba(0, 0, 0, 0.38); }
.hero-cross { display: flex; width: 360rpx; align-items: center; gap: 18rpx; margin: 24rpx 0; }
.hero-cross view { flex: 1; height: 1rpx; background: rgba(243, 240, 232, 0.55); }
.hero-cross text { font-family: serif; font-size: 28rpx; }
.hero-subtitle { margin-top: 34rpx; font-size: 21rpx; letter-spacing: 14rpx; }

.hero-meta { display: flex; flex-direction: column; align-items: center; }
.hero-date { font-size: 38rpx; letter-spacing: 10rpx; }
.hero-venue { margin-top: 12rpx; color: #d2dde4; font-size: 21rpx; letter-spacing: 7rpx; }
.hero-quote { margin-top: 48rpx; font-size: 24rpx; letter-spacing: 4rpx; }
.scroll-cue { display: flex; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; margin-top: 38rpx; border: 1rpx solid rgba(243, 240, 232, 0.3); border-radius: 50%; }
.scroll-cue view { width: 1rpx; height: 18rpx; background: #f3f0e8; transform: rotate(45deg); }

.chapter-row { display: flex; align-items: center; justify-content: space-between; }
.chapter-row--dark .chapter-index { color: #8194a4; }
.countdown-section { margin-top: 0; padding: 110rpx 40rpx 120rpx; }
.countdown-heading { margin-top: 26rpx; font-size: 46rpx; }
.countdown-editorial { margin-top: 68rpx; border-top: 1rpx solid rgba(11, 24, 38, 0.28); border-bottom: 1rpx solid rgba(11, 24, 38, 0.18); }
.countdown-main { display: flex; align-items: flex-end; justify-content: space-between; padding: 42rpx 0 34rpx; }
.countdown-number { font-size: 148rpx; line-height: 0.9; }
.countdown-unit { display: flex; flex-direction: column; align-items: flex-end; gap: 9rpx; }
.countdown-unit text:first-child { font-family: "Songti SC", serif; font-size: 28rpx; }
.countdown-unit text:last-child { color: #647482; font-size: 15rpx; letter-spacing: 5rpx; }
.countdown-rest { display: flex; padding: 30rpx 0; border-top: 1rpx solid rgba(11, 24, 38, 0.14); }
.countdown-rest view { display: flex; flex: 1; flex-direction: column; gap: 9rpx; border-right: 1rpx solid rgba(11, 24, 38, 0.12); text-align: center; }
.countdown-rest view:last-child { border-right: 0; }
.countdown-rest text:first-child { font-family: "Times New Roman", serif; font-size: 34rpx; }
.countdown-rest text:last-child { color: #6d7983; font-size: 13rpx; letter-spacing: 3rpx; }
.countdown-note { display: block; margin-top: 38rpx; color: #465764; font-size: 25rpx; letter-spacing: 3rpx; }

.story-section { position: relative; height: 1120rpx; overflow: hidden; background: #050608; }
.story-section > image,
.story-shade { position: absolute; width: 100%; height: 100%; }
.story-section > image { filter: saturate(0.74) brightness(0.8); }
.story-shade { background: linear-gradient(180deg, rgba(2, 5, 8, 0.05), rgba(2, 5, 8, 0.15) 48%, rgba(2, 5, 8, 0.96)); }
.story-copy { position: absolute; right: 40rpx; bottom: 60rpx; left: 40rpx; }
.story-title { display: block; margin-top: 24rpx; font-size: 56rpx; letter-spacing: 7rpx; }
.story-body { display: block; max-width: 610rpx; margin-top: 24rpx; color: #a9b8c3; font-size: 24rpx; line-height: 1.8; }
.story-line { display: flex; align-items: center; gap: 18rpx; margin-top: 42rpx; color: #8c9dac; font-size: 18rpx; letter-spacing: 3rpx; }
.story-line view { flex: 1; height: 1rpx; background: rgba(216, 225, 231, 0.3); }

.entry-section { padding-top: 110rpx; padding-bottom: 110rpx; }
.entry-list { margin-top: 54rpx; }
.entry-card { display: flex; min-height: 180rpx; align-items: center; gap: 26rpx; padding: 32rpx 4rpx; }
.entry-number { width: 62rpx; color: #52697b; font-size: 28rpx; }
.entry-main { min-width: 0; flex: 1; }
.entry-title { display: block; font-size: 38rpx; letter-spacing: 5rpx; }
.entry-copy { display: block; margin-top: 16rpx; color: #8193a2; font-size: 21rpx; }
.entry-arrow { font-size: 34rpx; font-weight: 200; }

.venue-section { padding: 100rpx 40rpx; }
.venue-card { position: relative; height: 820rpx; overflow: hidden; border-radius: 260rpx 260rpx 22rpx 22rpx; background: #07111f; }
.venue-card image,
.venue-overlay { position: absolute; width: 100%; height: 100%; }
.venue-card image { filter: saturate(0.62) brightness(0.68); }
.venue-overlay { background: linear-gradient(180deg, transparent 35%, rgba(3, 8, 15, 0.94)); }
.venue-content { position: absolute; right: 34rpx; bottom: 36rpx; left: 34rpx; color: #f3f0e8; }
.venue-content .chapter-index { color: #91a2ae; }
.venue-name { display: block; margin-top: 18rpx; font-size: 48rpx; letter-spacing: 5rpx; }
.venue-date { display: block; margin-top: 14rpx; color: #b7c4ce; font-size: 22rpx; letter-spacing: 5rpx; }
.venue-button { display: flex; width: 100%; min-height: 84rpx; align-items: center; justify-content: space-between; margin-top: 30rpx; padding: 0 28rpx; border-top: 1rpx solid rgba(243, 240, 232, 0.35); color: #f3f0e8; font-size: 23rpx; letter-spacing: 4rpx; }

.city-section { position: relative; height: 980rpx; overflow: hidden; background: #05080d; }
.city-section > image,
.city-shade { position: absolute; width: 100%; height: 100%; }
.city-section > image { filter: saturate(0.68) brightness(0.78); transform: scale(1.02); }
.city-shade { background: linear-gradient(180deg, rgba(3, 8, 15, 0.08), rgba(3, 8, 15, 0.22) 42%, rgba(3, 8, 15, 0.96)); }
.city-route { position: absolute; top: 120rpx; right: 44rpx; display: flex; height: 310rpx; flex-direction: column; align-items: center; justify-content: space-between; }
.city-route::before { position: absolute; top: 8rpx; bottom: 8rpx; left: 50%; width: 1rpx; background: linear-gradient(180deg, rgba(132, 209, 233, 0.1), rgba(132, 209, 233, 0.72), rgba(132, 209, 233, 0.1)); content: ""; }
.city-route view { position: relative; z-index: 1; width: 12rpx; height: 12rpx; border: 1rpx solid rgba(190, 227, 238, 0.8); border-radius: 50%; background: #07111f; box-shadow: 0 0 22rpx rgba(94, 205, 238, 0.5); }
.city-content { position: absolute; right: 40rpx; bottom: 48rpx; left: 40rpx; }
.city-copy { margin-top: 300rpx; }
.city-title { display: block; font-size: 50rpx; letter-spacing: 6rpx; }
.city-description { display: block; max-width: 610rpx; margin-top: 24rpx; color: #aab9c4; font-size: 24rpx; line-height: 1.8; }
.city-link { display: flex; align-items: center; justify-content: space-between; margin-top: 42rpx; padding-top: 26rpx; border-top: 1rpx solid rgba(216, 225, 231, 0.28); color: #dce7ec; font-size: 20rpx; letter-spacing: 3rpx; }
.city-link text:first-child { color: #7f94a5; }

.invitation-end { position: relative; min-height: 1080rpx; overflow: hidden; }
.invitation-end > image,
.end-shade { position: absolute; width: 100%; height: 100%; }
.invitation-end > image { filter: saturate(0.78) brightness(0.65); }
.end-shade { background: linear-gradient(180deg, rgba(3, 8, 15, 0.3), rgba(3, 8, 15, 0.9)); }
.end-content { position: relative; z-index: 2; display: flex; min-height: 1080rpx; flex-direction: column; align-items: center; justify-content: center; padding: 90rpx 40rpx; text-align: center; }
.end-title { margin: 36rpx 0 58rpx; font-size: 48rpx; line-height: 1.65; letter-spacing: 6rpx; }
.end-title text { display: block; }
.share-button { margin-top: 22rpx; color: #a7b6c2; font-size: 21rpx; letter-spacing: 4rpx; }
.end-sign { margin-top: 100rpx; color: #728597; font-size: 20rpx; letter-spacing: 7rpx; }
