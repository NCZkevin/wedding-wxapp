.invite-page {
  padding-bottom: calc(152rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  padding: calc(36rpx + env(safe-area-inset-top)) 40rpx 54rpx;
  background: #07111f;
}

.hero-image,
.hero-shade,
.hero-beam,
.stars {
  position: absolute;
  inset: 0;
}

.hero-image {
  width: 100%;
  height: 100%;
  transform: scale(1.22);
  filter: saturate(0.8) contrast(1.08);
}

.hero-shade {
  background: linear-gradient(180deg, rgba(4, 9, 17, 0.5) 0%, rgba(4, 9, 17, 0.05) 28%, rgba(4, 9, 17, 0.1) 54%, #07111f 100%);
}

.hero-beam {
  left: 42%;
  width: 16%;
  background: linear-gradient(180deg, rgba(168, 228, 242, 0.08), rgba(168, 228, 242, 0.2) 50%, transparent 94%);
  filter: blur(3rpx);
}

.stars {
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  background: #f3f0e8;
  box-shadow: 90rpx 180rpx #f3f0e8, 250rpx 90rpx #d8e1e7, 410rpx 240rpx #f3f0e8, 560rpx 150rpx #d8e1e7, 650rpx 330rpx #f3f0e8, 120rpx 420rpx #d8e1e7, 500rpx 520rpx #f3f0e8;
  opacity: 0.6;
}

.stars-b {
  top: 34%;
  left: 12%;
  transform: scale(0.65);
  animation: shimmer 3.8s ease-in-out infinite alternate;
}

@keyframes shimmer {
  from { opacity: 0.15; }
  to { opacity: 0.7; }
}

.hero-top,
.hero-content,
.hero-meta {
  position: relative;
  z-index: 2;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-kicker {
  font-size: 19rpx;
  letter-spacing: 7rpx;
}

.music-button {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(243, 240, 232, 0.7);
  border-radius: 50%;
}

.music-icon {
  display: flex;
  height: 25rpx;
  align-items: center;
  gap: 5rpx;
}

.music-icon view {
  width: 3rpx;
  height: 12rpx;
  background: #f3f0e8;
}

.music-icon view:nth-child(2) { height: 24rpx; }
.music-button.is-playing .music-icon view { animation: equalizer 0.8s ease-in-out infinite alternate; }
.music-button.is-playing .music-icon view:nth-child(2) { animation-delay: 0.2s; }
.music-button.is-playing .music-icon view:nth-child(3) { animation-delay: 0.4s; }

@keyframes equalizer {
  from { transform: scaleY(0.45); }
  to { transform: scaleY(1); }
}

.hero-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 18vh;
}

.hero-title {
  font-size: 72rpx;
  font-weight: 400;
  letter-spacing: 14rpx;
  text-shadow: 0 4rpx 28rpx rgba(0, 0, 0, 0.38);
}

.hero-cross {
  display: flex;
  width: 360rpx;
  align-items: center;
  gap: 18rpx;
  margin: 24rpx 0;
}

.hero-cross view {
  flex: 1;
  height: 1rpx;
  background: rgba(243, 240, 232, 0.55);
}

.hero-cross text {
  font-family: serif;
  font-size: 28rpx;
}

.hero-subtitle {
  margin-top: 34rpx;
  font-size: 23rpx;
  letter-spacing: 14rpx;
}

.hero-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-date {
  font-size: 38rpx;
  letter-spacing: 10rpx;
}

.hero-venue {
  margin-top: 12rpx;
  color: #d2dde4;
  font-size: 23rpx;
  letter-spacing: 7rpx;
}

.hero-quote {
  margin-top: 48rpx;
  font-size: 25rpx;
  letter-spacing: 4rpx;
}

.scroll-cue {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  margin-top: 42rpx;
  border: 1rpx solid rgba(243, 240, 232, 0.32);
  border-radius: 50%;
}

.scroll-cue view {
  width: 1rpx;
  height: 18rpx;
  background: #f3f0e8;
  box-shadow: -5rpx 12rpx 0 -1rpx #f3f0e8;
  transform: rotate(-45deg);
}

.countdown {
  margin-top: 48rpx;
  padding: 44rpx;
}

.countdown-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.countdown-number {
  font-size: 116rpx;
  line-height: 1;
}

.countdown-label {
  color: #91a4b4;
  font-size: 20rpx;
  letter-spacing: 7rpx;
}

.countdown-rest {
  display: flex;
  margin-top: 34rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(216, 225, 231, 0.18);
}

.countdown-rest view {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  border-right: 1rpx solid rgba(216, 225, 231, 0.16);
  text-align: center;
}

.countdown-rest view:last-child { border-right: 0; }
.countdown-rest text:first-child { font-family: serif; font-size: 36rpx; }
.countdown-rest text:last-child { color: #748699; font-size: 17rpx; letter-spacing: 4rpx; }

.stage-card {
  position: relative;
  height: 780rpx;
  margin-top: 48rpx;
  overflow: hidden;
  border-radius: 340rpx 340rpx 28rpx 28rpx;
  background: #050608;
}

.stage-card image {
  width: 100%;
  height: 100%;
  filter: saturate(0.72) contrast(1.08);
}

.stage-card::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 50%, rgba(4, 7, 11, 0.88));
  content: '';
}

.stage-caption {
  position: absolute;
  z-index: 2;
  right: 38rpx;
  bottom: 42rpx;
  left: 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(243, 240, 232, 0.38);
  font-size: 28rpx;
}

.stage-caption text:first-child { color: #8fa0b1; font-size: 18rpx; letter-spacing: 3rpx; }

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 46rpx;
}

.entry-card {
  display: flex;
  min-height: 190rpx;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 34rpx;
}

.entry-card > view {
  display: grid;
  grid-template-columns: 56rpx 1fr;
  column-gap: 20rpx;
  align-items: center;
}

.entry-index { color: #71889a; font-size: 18rpx; letter-spacing: 3rpx; }
.entry-title { display: block; font-size: 38rpx; letter-spacing: 5rpx; }
.entry-copy { grid-column: 2; margin-top: 16rpx; color: #8fa0b1; font-size: 22rpx; }
.entry-arrow { font-size: 36rpx; font-weight: 200; }

.venue-card {
  position: relative;
  height: 700rpx;
  overflow: hidden;
  border-radius: 36rpx;
}

.venue-card image,
.venue-overlay {
  position: absolute;
  width: 100%;
  height: 100%;
}

.venue-card image { filter: saturate(0.58) brightness(0.62); }
.venue-overlay { background: linear-gradient(180deg, rgba(3, 8, 15, 0.05), rgba(3, 8, 15, 0.92)); }

.venue-content {
  position: absolute;
  right: 38rpx;
  bottom: 40rpx;
  left: 38rpx;
}

.venue-name {
  display: block;
  margin-top: 18rpx;
  font-size: 50rpx;
  letter-spacing: 5rpx;
}

.venue-date { display: block; margin-top: 14rpx; color: #b7c4ce; font-size: 24rpx; letter-spacing: 5rpx; }
.venue-button { width: 260rpx; min-height: 78rpx; margin-top: 32rpx; font-size: 24rpx; }

.invitation-end {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 150rpx;
  text-align: center;
}

.end-title {
  margin: 36rpx 0 58rpx;
  font-size: 48rpx;
  line-height: 1.65;
  letter-spacing: 6rpx;
}

.end-title text { display: block; }

.share-button {
  margin-top: 20rpx;
  color: #a7b6c2;
  font-size: 23rpx;
  letter-spacing: 4rpx;
}

.end-sign {
  margin-top: 100rpx;
  color: #64788a;
  font-size: 21rpx;
  letter-spacing: 7rpx;
}
