<view class="page-shell rsvp-page">
  <view wx:if="{{submitted}}" class="success-view">
    <image src="/assets/images/floral-sculpture.jpg" mode="aspectFill" />
    <view class="success-shade"></view>
    <view class="success-content">
      <view class="success-mark"><view></view></view>
      <text class="eyebrow">REPLY RECEIVED</text>
      <text class="success-title serif">期待与你见面</text>
      <view class="success-copy">
        <text>{{form.name}}，你的回复已经保存。</text>
        <text>婚礼临近时，我们会再向你发送最终提醒。</text>
      </view>
      <view class="success-summary glass-card">
        <view><text>出席状态</text><text>{{form.attendance === 'yes' ? '确认出席' : form.attendance === 'no' ? '无法出席' : '暂未确定'}}</text></view>
        <view><text>出席人数</text><text>{{form.guestCount}} 人</text></view>
        <view><text>婚礼日期</text><text>{{wedding.dateDisplay}}</text></view>
      </view>
      <button class="ivory-button" bindtap="editRsvp">修改回复</button>
      <button class="success-home" bindtap="goHome">返回邀请函</button>
    </view>
  </view>

  <block wx:else>
    <view class="rsvp-hero">
      <image src="/assets/images/handover-stage.jpg" mode="aspectFill" />
      <view class="rsvp-shade"></view>
      <view class="rsvp-hero-content">
        <text class="eyebrow">BE OUR GUEST</text>
        <text class="rsvp-title serif">确认出席</text>
        <text class="rsvp-intro">请在 2026 年 8 月 20 日前告诉我们，你是否会来到现场。</text>
      </view>
    </view>

    <view class="rsvp-form">
      <view class="attendance-field">
        <text class="field-label">是否出席</text>
        <view class="attendance-options">
          <view class="attendance-option {{form.attendance === 'yes' ? 'is-active' : ''}}" data-value="yes" bindtap="chooseAttendance">
            <view class="radio"><view></view></view>
            <text>欣然出席</text>
          </view>
          <view class="attendance-option {{form.attendance === 'unsure' ? 'is-active' : ''}}" data-value="unsure" bindtap="chooseAttendance">
            <view class="radio"><view></view></view>
            <text>暂未确定</text>
          </view>
          <view class="attendance-option {{form.attendance === 'no' ? 'is-active' : ''}}" data-value="no" bindtap="chooseAttendance">
            <view class="radio"><view></view></view>
            <text>遗憾缺席</text>
          </view>
        </view>
      </view>

      <view class="form-field">
        <text class="field-label">姓名 *</text>
        <input value="{{form.name}}" placeholder="请输入你的姓名" placeholder-class="placeholder" data-field="name" bindinput="inputField" />
      </view>

      <view class="form-field">
        <text class="field-label">手机号码 *</text>
        <input type="number" maxlength="11" value="{{form.phone}}" placeholder="用于接收婚礼提醒" placeholder-class="placeholder" data-field="phone" bindinput="inputField" />
      </view>

      <view class="form-field" wx:if="{{form.attendance !== 'no'}}">
        <text class="field-label">出席人数</text>
        <picker mode="selector" range="{{countOptions}}" value="{{form.guestCount - 1}}" bindchange="chooseCount">
          <view class="picker-value">
            <text>{{form.guestCount}} 人</text>
            <text>⌄</text>
          </view>
        </picker>
      </view>

      <view class="form-field" wx:if="{{form.attendance !== 'no'}}">
        <text class="field-label">饮食备注</text>
        <input value="{{form.diet}}" placeholder="如素食、过敏等，没有可不填" placeholder-class="placeholder" data-field="diet" bindinput="inputField" />
      </view>

      <view class="form-field message-field">
        <text class="field-label">想对我们说</text>
        <textarea maxlength="160" value="{{form.message}}" placeholder="留下一句话……" placeholder-class="placeholder" data-field="message" bindinput="inputField" />
        <text class="message-count">{{form.message.length}} / 160</text>
      </view>

      <view class="privacy-note">
        <view class="privacy-shield">✓</view>
        <text>你填写的信息只用于婚礼签到、席位安排和必要提醒。</text>
      </view>

      <button class="ivory-button submit-button" bindtap="submitRsvp">提交 RSVP</button>
      <text class="form-sign serif">张凯文 × 刘明玥</text>
    </view>
  </block>

  <view class="safe-bottom"></view>
</view>
