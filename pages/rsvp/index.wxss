.rsvp-hero {
  position: relative;
  height: 700rpx;
  overflow: hidden;
}

.rsvp-hero image,
.rsvp-shade {
  position: absolute;
  width: 100%;
  height: 100%;
}

.rsvp-hero image { filter: saturate(0.65) brightness(0.76); }
.rsvp-shade { background: linear-gradient(180deg, rgba(3, 8, 15, 0.05), #07111f 100%); }

.rsvp-hero-content {
  position: absolute;
  right: 40rpx;
  bottom: 42rpx;
  left: 40rpx;
}

.rsvp-title {
  display: block;
  margin-top: 20rpx;
  font-size: 70rpx;
  letter-spacing: 10rpx;
}

.rsvp-intro {
  display: block;
  max-width: 590rpx;
  margin-top: 22rpx;
  color: #a7b6c2;
  font-size: 24rpx;
  line-height: 1.7;
}

.rsvp-form {
  padding: 60rpx 40rpx 40rpx;
}

.field-label {
  display: block;
  color: #879aaa;
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.attendance-field,
.form-field {
  margin-bottom: 54rpx;
}

.attendance-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.attendance-option {
  display: flex;
  min-height: 88rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border: 1rpx solid rgba(216, 225, 231, 0.18);
  border-radius: 16rpx;
  color: #8296a7;
  background: rgba(16, 42, 70, 0.36);
  font-size: 22rpx;
  white-space: nowrap;
}

.attendance-option.is-active {
  border-color: rgba(216, 225, 231, 0.7);
  color: #f3f0e8;
  background: rgba(36, 71, 101, 0.64);
}

.radio {
  display: flex;
  width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid currentColor;
  border-radius: 50%;
}

.radio view { width: 12rpx; height: 12rpx; border-radius: 50%; }
.attendance-option.is-active .radio view { background: #f3f0e8; }

.form-field input,
.picker-value {
  display: flex;
  width: 100%;
  min-height: 96rpx;
  align-items: center;
  margin-top: 18rpx;
  padding: 0 26rpx;
  border: 1rpx solid rgba(216, 225, 231, 0.22);
  border-radius: 16rpx;
  color: #f3f0e8;
  background: rgba(16, 42, 70, 0.36);
  font-size: 27rpx;
}

.picker-value { justify-content: space-between; }
.placeholder { color: #52687a; }

.message-field {
  position: relative;
}

.message-field textarea {
  width: 100%;
  height: 250rpx;
  margin-top: 18rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(216, 225, 231, 0.22);
  border-radius: 16rpx;
  color: #f3f0e8;
  background: rgba(16, 42, 70, 0.36);
  font-family: "Songti SC", serif;
  font-size: 27rpx;
  line-height: 1.7;
}

.message-count {
  position: absolute;
  right: 20rpx;
  bottom: 18rpx;
  color: #52687a;
  font-size: 18rpx;
}

.privacy-note {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(216, 225, 231, 0.15);
  border-radius: 16rpx;
  color: #71879a;
  background: rgba(5, 12, 21, 0.58);
  font-size: 20rpx;
  line-height: 1.7;
}

.privacy-shield {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 34rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #71879a;
  border-radius: 50% 50% 60% 60%;
  font-size: 18rpx;
}

.submit-button { margin-top: 30rpx; }
.form-sign { display: block; margin-top: 84rpx; color: #506679; font-size: 22rpx; letter-spacing: 8rpx; text-align: center; }

.success-view {
  position: relative;
  min-height: calc(100vh - 140rpx);
  overflow: hidden;
}

.success-view > image,
.success-shade {
  position: absolute;
  width: 100%;
  height: 100%;
}

.success-view > image { filter: saturate(0.2) hue-rotate(170deg) brightness(0.42); }
.success-shade { background: linear-gradient(180deg, rgba(7, 17, 31, 0.2), #07111f 78%); }

.success-content {
  position: relative;
  z-index: 2;
  display: flex;
  min-height: calc(100vh - 140rpx);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.success-mark {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 42rpx;
  border: 1rpx solid rgba(216, 225, 231, 0.62);
  border-radius: 50%;
}

.success-mark view {
  width: 24rpx;
  height: 40rpx;
  border-right: 2rpx solid #f3f0e8;
  border-bottom: 2rpx solid #f3f0e8;
  transform: rotate(45deg) translate(-5rpx, -5rpx);
}

.success-title { margin-top: 24rpx; font-size: 58rpx; letter-spacing: 8rpx; }
.success-copy { margin-top: 26rpx; color: #9eafbb; font-size: 24rpx; line-height: 1.8; }
.success-copy text { display: block; }

.success-summary {
  width: 100%;
  margin: 50rpx 0 30rpx;
  padding: 18rpx 30rpx;
  text-align: left;
}

.success-summary view {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(216, 225, 231, 0.14);
  font-size: 23rpx;
}

.success-summary view:last-child { border-bottom: 0; }
.success-summary text:first-child { color: #71879a; }
.success-home { margin-top: 24rpx; color: #879aaa; font-size: 22rpx; letter-spacing: 4rpx; }
