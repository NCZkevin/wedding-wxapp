.schedule-hero { position: relative; height: 880rpx; overflow: hidden; background: #050608; }
.schedule-hero image,
.schedule-hero-shade { position: absolute; width: 100%; height: 100%; }
.schedule-hero image { filter: saturate(0.72) brightness(0.78); }
.schedule-hero-shade { background: linear-gradient(180deg, rgba(3, 8, 15, 0.06) 20%, rgba(3, 8, 15, 0.92) 100%); }
.schedule-hero-copy { position: absolute; right: 40rpx; bottom: 50rpx; left: 40rpx; }
.schedule-status { display: flex; align-items: center; gap: 14rpx; margin-bottom: 34rpx; color: #a7b7c2; font-size: 18rpx; letter-spacing: 5rpx; }
.schedule-status view { width: 10rpx; height: 10rpx; border-radius: 50%; background: #d8e1e7; box-shadow: 0 0 22rpx rgba(216, 225, 231, 0.8); }
.schedule-title { display: block; margin-top: 20rpx; font-size: 72rpx; letter-spacing: 10rpx; }
.schedule-date { display: block; margin-top: 20rpx; color: #b6c3cd; font-size: 21rpx; letter-spacing: 5rpx; }
.calendar-button { display: flex; width: 230rpx; min-height: 72rpx; align-items: center; justify-content: space-between; margin-top: 32rpx; padding: 0 22rpx; border-top: 1rpx solid rgba(216, 225, 231, 0.44); border-bottom: 1rpx solid rgba(216, 225, 231, 0.18); color: #f3f0e8; font-size: 21rpx; letter-spacing: 3rpx; }

.chapter-row { display: flex; align-items: center; justify-content: space-between; }
.timeline-section { padding-top: 110rpx; padding-bottom: 80rpx; }
.timeline { margin-top: 70rpx; }
.timeline-item { position: relative; display: flex; min-height: 250rpx; opacity: 0.52; transition: opacity 300ms ease; }
.timeline-item.is-past { opacity: 0.7; }
.timeline-item.is-active { opacity: 1; }
.timeline-light { position: relative; width: 80rpx; flex: 0 0 80rpx; }
.timeline-dot { position: absolute; z-index: 2; top: 17rpx; left: 15rpx; width: 15rpx; height: 15rpx; border: 3rpx solid rgba(144, 205, 232, 0.22); border-radius: 50%; background: #8295a3; }
.timeline-item.is-past .timeline-dot { background: #c5d1d8; }
.timeline-item.is-active .timeline-dot { background: #fff; box-shadow: 0 0 22rpx 8rpx rgba(159, 219, 242, 0.34); }
.timeline-line { position: absolute; top: 38rpx; bottom: -18rpx; left: 22rpx; width: 1rpx; background: linear-gradient(180deg, rgba(216, 225, 231, 0.55), rgba(216, 225, 231, 0.08)); }
.light-beam { display: none; position: absolute; z-index: 0; top: -80rpx; left: -90rpx; width: 220rpx; height: 250rpx; background: radial-gradient(ellipse at center, rgba(107, 194, 226, 0.22), transparent 66%); filter: blur(12rpx); }
.timeline-item.is-active .light-beam { display: block; animation: lightBreath 2.4s ease-in-out infinite alternate; }
@keyframes lightBreath { from { opacity: 0.45; transform: scale(0.9); } to { opacity: 1; transform: scale(1.08); } }
.timeline-content { min-width: 0; flex: 1; padding-bottom: 72rpx; }
.timeline-head { display: flex; align-items: center; justify-content: space-between; }
.timeline-time { color: #c9d9e3; font-size: 42rpx; letter-spacing: 3rpx; }
.live-label { padding: 8rpx 12rpx; border: 1rpx solid rgba(216, 225, 231, 0.32); border-radius: 20rpx; color: #d8e1e7; font-size: 14rpx; letter-spacing: 4rpx; }
.timeline-title { display: block; margin-top: 22rpx; font-size: 38rpx; letter-spacing: 5rpx; }
.timeline-copy { display: block; margin-top: 18rpx; color: #8598a8; font-size: 23rpx; line-height: 1.7; }

.activities-section { padding: 110rpx 40rpx 120rpx; }
.activity-list { margin-top: 58rpx; }
.activity-row { display: flex; min-height: 180rpx; align-items: center; gap: 24rpx; padding: 28rpx 0; }
.activity-index { width: 56rpx; color: #637380; font-size: 28rpx; }
.activity-main { min-width: 0; flex: 1; }
.activity-title { display: block; font-size: 34rpx; letter-spacing: 4rpx; }
.activity-copy { display: block; margin-top: 13rpx; color: #647482; font-size: 20rpx; line-height: 1.6; }
.activity-arrow { font-size: 31rpx; }

.guide-section { position: relative; min-height: 1050rpx; overflow: hidden; }
.guide-section > image,
.guide-shade { position: absolute; width: 100%; height: 100%; }
.guide-section > image { filter: saturate(0.62) brightness(0.68); }
.guide-shade { background: linear-gradient(180deg, rgba(3, 8, 15, 0.08), rgba(3, 8, 15, 0.96) 76%); }
.guide-content { position: relative; z-index: 2; display: flex; min-height: 1050rpx; flex-direction: column; justify-content: flex-end; padding: 90rpx 40rpx; }
.guide-title { margin-top: 22rpx; font-size: 56rpx; letter-spacing: 7rpx; }
.guide-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 42rpx; }
.guide-item { min-height: 180rpx; padding: 28rpx 24rpx; border-top: 1rpx solid rgba(216, 225, 231, 0.3); background: rgba(5, 12, 21, 0.38); }
.guide-item text:first-child,
.guide-note text:first-child { display: block; color: #8397a8; font-size: 18rpx; letter-spacing: 4rpx; }
.guide-item text:last-child { display: block; margin-top: 28rpx; font-size: 28rpx; line-height: 1.5; }
.guide-note { margin-top: 18rpx; padding: 28rpx 24rpx; border-top: 1rpx solid rgba(216, 225, 231, 0.3); }
.guide-note text:last-child { display: block; margin-top: 18rpx; color: #bdc8cf; font-size: 22rpx; line-height: 1.7; }
