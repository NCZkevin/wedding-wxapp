.schedule-hero {
  position: relative;
  height: 720rpx;
  overflow: hidden;
  background: #050608;
}

.schedule-hero image,
.schedule-hero-shade {
  position: absolute;
  width: 100%;
  height: 100%;
}

.schedule-hero image { filter: saturate(0.72) brightness(0.82); }
.schedule-hero-shade { background: linear-gradient(180deg, rgba(3, 8, 15, 0.05) 30%, #07111f 100%); }

.schedule-hero-copy {
  position: absolute;
  right: 40rpx;
  bottom: 54rpx;
  left: 40rpx;
}

.schedule-title {
  display: block;
  margin-top: 20rpx;
  font-size: 72rpx;
  letter-spacing: 10rpx;
}

.schedule-date {
  display: block;
  margin-top: 20rpx;
  color: #b6c3cd;
  font-size: 22rpx;
  letter-spacing: 5rpx;
}

.timeline {
  margin-top: 58rpx;
}

.timeline-item {
  display: flex;
  min-height: 230rpx;
}

.timeline-axis {
  position: relative;
  width: 70rpx;
  flex: 0 0 70rpx;
}

.timeline-dot {
  position: absolute;
  z-index: 2;
  top: 17rpx;
  left: 12rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid rgba(144, 205, 232, 0.28);
  border-radius: 50%;
  background: #f3f0e8;
  box-shadow: 0 0 24rpx rgba(139, 211, 242, 0.56);
}

.timeline-line {
  position: absolute;
  top: 37rpx;
  bottom: -17rpx;
  left: 21rpx;
  width: 1rpx;
  background: linear-gradient(180deg, rgba(216, 225, 231, 0.65), rgba(216, 225, 231, 0.08));
}

.timeline-content {
  flex: 1;
  padding-bottom: 64rpx;
}

.timeline-time {
  display: inline-block;
  width: 150rpx;
  color: #c9d9e3;
  font-size: 42rpx;
  letter-spacing: 3rpx;
}

.timeline-title {
  font-size: 38rpx;
  letter-spacing: 5rpx;
}

.timeline-copy {
  display: block;
  margin-top: 22rpx;
  color: #8598a8;
  font-size: 24rpx;
  line-height: 1.7;
}

.activities-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 46rpx;
}

.activity-card {
  min-height: 340rpx;
  padding: 26rpx;
}

.activity-top {
  display: flex;
  justify-content: space-between;
  color: #7f93a4;
  font-size: 19rpx;
  letter-spacing: 3rpx;
}

.activity-title {
  display: block;
  margin-top: 70rpx;
  font-size: 34rpx;
  letter-spacing: 4rpx;
}

.activity-copy {
  display: block;
  margin-top: 20rpx;
  color: #879aaa;
  font-size: 21rpx;
  line-height: 1.7;
}

.guide-card {
  position: relative;
  min-height: 760rpx;
  margin-top: 46rpx;
  overflow: hidden;
  border-radius: 36rpx;
}

.guide-card image,
.guide-shade {
  position: absolute;
  width: 100%;
  height: 100%;
}

.guide-card image { filter: saturate(0.65) brightness(0.7); }
.guide-shade { background: linear-gradient(180deg, rgba(4, 8, 13, 0.12), rgba(4, 8, 13, 0.95) 58%); }

.guide-content {
  position: absolute;
  right: 34rpx;
  bottom: 18rpx;
  left: 34rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid rgba(216, 225, 231, 0.2);
  border-radius: 26rpx;
  background: rgba(6, 15, 26, 0.7);
  backdrop-filter: blur(20rpx);
}

.guide-row { padding: 24rpx 4rpx; }
.guide-label { display: block; color: #8397a8; font-size: 19rpx; letter-spacing: 4rpx; }
.guide-value { display: block; margin-top: 18rpx; font-size: 32rpx; letter-spacing: 4rpx; }
.guide-note { display: block; margin-top: 18rpx; color: #c2cdd4; font-size: 23rpx; line-height: 1.7; }
