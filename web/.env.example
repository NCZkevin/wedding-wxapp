# Browser-visible values
VITE_SITE_URL=https://wedding.nczkevin.com

# API runtime
HOST=127.0.0.1
PORT=8787
TRUST_PROXY=true
PUBLIC_BASE_URL=https://wedding.nczkevin.com

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=wedding
MYSQL_USER=wedding_app
MYSQL_PASSWORD=change-me

# Store the newly reset secret only on the server. Never commit a real value.
WECHAT_APP_ID=wxbbe33656e510c3ae
WECHAT_APP_SECRET=replace-on-server

# Local development path. Set /data/wedding/uploads in production.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# Used as the /admin password and for the protected CSV export endpoint.
ADMIN_EXPORT_TOKEN=replace-with-a-long-random-token
