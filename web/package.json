{
  "name": "wedding-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:server": "tsx watch server/src/index.ts",
    "db:migrate": "tsx server/src/migrate.ts",
    "build": "npm run typecheck && vite build --configLoader runner && tsc -p server/tsconfig.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "node --import tsx --test server/src/**/*.test.ts",
    "preview": "vite preview --configLoader runner"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "mysql2": "^3.15.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vue-tsc": "^3.1.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
